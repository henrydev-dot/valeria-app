# ---- Core ----
PORT=3000
MONGODB_URI=mongodb://localhost:27017/valerifal

# ---- Auth (MUST be set in production; app refuses weak defaults) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# ---- AI ----
# AI_BYPASS=true  -> readings return ready/canned (no external AI call). Default.
# AI_BYPASS=false -> use real Gemini (requires GEMINI_API_KEY + valid GEMINI_MODEL).
AI_BYPASS=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Push notifications (admin broadcast) ----
EXPO_ACCESS_TOKEN=
