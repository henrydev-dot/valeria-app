# ---- Core ----
PORT=3000
MONGODB_URI=mongodb://localhost:27017/valerifal

# ---- Auth (MUST be set in production; app refuses weak defaults) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# ---- AI ----
# AI_BYPASS=true  -> fallar hazır/canned metin döner (dış AI çağrısı yok).
# AI_BYPASS=false -> aşağıdaki sağlayıcı kullanılır. Prod'da false olmalı.
AI_BYPASS=false

# Sağlayıcı: "deepseek" | "gemini".
# Boş bırakılırsa: DEEPSEEK_API_KEY tanımlıysa deepseek, değilse gemini.
AI_PROVIDER=deepseek

# DeepSeek (OpenAI-uyumlu API — https://api.deepseek.com)
# QUALITY: fallar, horary, numeroloji, tarot açılımı (deepseek-v4-pro)
# FAST:    günlük/haftalık burç, uyum, günlük tarot mesajı (deepseek-v4-flash)
# NOT: deepseek-chat / deepseek-reasoner 2026-07-24'te kullanımdan kalktı.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_QUALITY=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini — kahve falı için ZORUNLU: fotoğraflar vision ile doğrulanır ve
# sembollere çevrilir (DeepSeek görsel okuyamaz). Key yoksa/doğrulama
# başarısızsa kahve falı VERİLMEZ ve kredi kesilmez (sahte/boş resim engeli).
# Ücretsiz katman (AI Studio) kahve doğrulaması için yeterlidir (~250 istek/gün).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Apple In-App Purchase (kredi paketleri) ----
# Consumable ürünler için shared secret şart değildir ama App Store Connect →
# App Information → App-Specific Shared Secret üretip eklemek önerilir.
APPLE_SHARED_SECRET=
# Eski mock satın alma ucu (/entitlements/add-credits). Prod'da KAPALI tutun.
ALLOW_MOCK_PURCHASES=false

# ---- Push notifications (admin broadcast) ----
EXPO_ACCESS_TOKEN=
